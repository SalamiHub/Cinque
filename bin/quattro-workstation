#!/usr/bin/env python3
"""quattro-workstation: engine-layer CLI for Cinque Hyprland session management.

Storage:
  ~/.config/quattro-workstations/config.json
  ~/.config/quattro-workstations/workstations/1.json .. 5.json

See README.md next to this script for the JSON format.
"""
import configparser
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

NUM_SLOTS = 5

# Desktop Entry Specification field codes: https://specifications.freedesktop.org/desktop-entry-spec/latest/exec-variables.html
FIELD_CODE_RE = re.compile(r"%[fFuUdDnNickvm]")

CONFIG_DIR = Path.home() / ".config" / "quattro-workstations"
CONFIG_FILE = CONFIG_DIR / "config.json"
WORKSTATIONS_DIR = CONFIG_DIR / "workstations"


def default_config():
    return {"fluidSlot": None, "bootSlot": None}


def default_workstation(n):
    return {"id": n, "name": f"Workstation {n}", "mode": "preset", "commands": []}


def ensure_initialized():
    WORKSTATIONS_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        write_json(CONFIG_FILE, default_config())
    for n in range(1, NUM_SLOTS + 1):
        path = workstation_path(n)
        if not path.exists():
            write_json(path, default_workstation(n))


def workstation_path(n):
    return WORKSTATIONS_DIR / f"{n}.json"


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, data):
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    tmp.replace(path)


def load_config():
    cfg = read_json(CONFIG_FILE)
    changed = False
    for key, value in default_config().items():
        if key not in cfg:
            cfg[key] = value
            changed = True
    if changed:
        write_json(CONFIG_FILE, cfg)
    return cfg


def save_config(cfg):
    write_json(CONFIG_FILE, cfg)


def load_workstation(n):
    path = workstation_path(n)
    if path.exists():
        return read_json(path)
    return default_workstation(n)


def save_workstation(n, data):
    write_json(workstation_path(n), data)


def validate_slot(n):
    if n < 1 or n > NUM_SLOTS:
        print(f"error: slot must be between 1 and {NUM_SLOTS}", file=sys.stderr)
        sys.exit(1)


def cmd_list(args):
    cfg = load_config()
    fluid_slot = cfg.get("fluidSlot")
    boot_slot = cfg.get("bootSlot")
    for n in range(1, NUM_SLOTS + 1):
        ws = load_workstation(n)
        tags = []
        tags.append("fluid (active)" if n == fluid_slot else ws.get("mode", "preset"))
        if n == boot_slot:
            tags.append("boots at startup")
        print(f"{n}: {ws.get('name', f'Workstation {n}')} [{', '.join(tags)}]")


def hyprctl_clients():
    result = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, check=False)
    try:
        return json.loads(result.stdout)
    except ValueError:
        return []


def client_addresses():
    return set(c["address"] for c in hyprctl_clients() if "address" in c)


def process_descendants(pid):
    # All descendant PIDs of `pid` (children, grandchildren, ...), by
    # walking /proc. `sh -c "<command>"` tail-execs into a single simple
    # command (same PID), but not every command is that simple (e.g. one
    # with "&&" or a wrapper script that forks), so a window can end up
    # owned by a PID a level or two below the one we spawned.
    parent_of = {}
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                with open(f"/proc/{entry}/stat") as f:
                    stat = f.read()
                ppid = int(stat[stat.rfind(")") + 2:].split()[1])
                parent_of[int(entry)] = ppid
            except (OSError, ValueError, IndexError):
                continue
    except OSError:
        return set()
    children_of = {}
    for child, parent in parent_of.items():
        children_of.setdefault(parent, []).append(child)
    result = set()
    frontier = [pid]
    while frontier:
        current = frontier.pop()
        for child in children_of.get(current, []):
            if child not in result:
                result.add(child)
                frontier.append(child)
    return result


def cmd_launch(args):
    n = args.n
    validate_slot(n)
    ws = load_workstation(n)
    commands = ws.get("commands", [])

    before = client_addresses()
    pids = []
    for entry in commands:
        command = entry["command"]
        workspace = entry["workspace"]
        # Switching first gives the common case (a single command, or a
        # fast-starting app) the same immediate "you're taken there" feel
        # as before. This Hyprland build's dispatch layer is Lua-based
        # (hl.dsp.*), not the classic "dispatch workspace <n>" string form.
        subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.focus({{workspace="{workspace}"}})'],
            check=False,
        )
        proc = subprocess.Popen(
            ["setsid", "nohup", "sh", "-c", command],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        pids.append(proc.pid)

    if commands:
        # Corrective safety net for slower apps: a multi-command slot
        # re-focuses for the NEXT command almost immediately, long before
        # a typical app (especially anything Electron-based) has actually
        # mapped a window -- so by the time it does, the active workspace
        # has already moved on and the switch above did nothing for it.
        # One detached watcher (not one per command) tracks every
        # command's target workspace and spawned PID, and for each still
        # tries a precise match first (a window whose owning process
        # descends from the PID we spawned for it) before falling back to
        # a weaker appearance-order heuristic for whatever's left --
        # needed because a singleton app (a browser or editor already
        # running) can hand the new window to its *existing* process
        # instead of the one just spawned here, which has no PID
        # relationship to it at all.
        targets = [str(entry["workspace"]) for entry in commands]
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "_place-windows",
             json.dumps(sorted(before)), json.dumps(targets), json.dumps(pids)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    print(f"launched workstation {n}: {ws.get('name', f'Workstation {n}')} ({len(commands)} commands)")


def cmd_place_windows(args):
    # Internal helper spawned by launch -- not a documented subcommand.
    seen = set(json.loads(args.before))
    targets = json.loads(args.targets)
    pids = json.loads(args.pids)
    pending = list(range(len(targets)))

    def move(address, workspace):
        subprocess.run(
            ["hyprctl", "dispatch",
             f'hl.dsp.window.move({{window="address:{address}", workspace="{workspace}", follow=false}})'],
            check=False,
        )

    # Phase 1: precise PID-tree match, tried first since it's unambiguous
    # -- correctly handles concurrent commands regardless of which one's
    # app finishes starting first. Recomputes each pending command's
    # descendant set every tick since the tree grows as the app forks.
    deadline = time.monotonic() + 4.0
    while pending and time.monotonic() < deadline:
        clients = hyprctl_clients()
        still_pending = []
        for i in pending:
            descendants = process_descendants(pids[i]) | {pids[i]}
            match = next((c for c in clients if c.get("pid") in descendants and c.get("address") not in seen), None)
            if match:
                move(match["address"], targets[i])
                seen.add(match["address"])
            else:
                still_pending.append(i)
        pending = still_pending
        if pending:
            time.sleep(0.15)

    # Phase 2 fallback: whatever's left is presumably a singleton app that
    # handed its new window to an already-running process with no PID
    # relationship to what we spawned. Assign newly-appeared windows, in
    # the order they appear, to the still-pending targets in launch order.
    # A heuristic, not a guarantee -- if two such apps finish starting in
    # a different order than they were launched, their target workspaces
    # can end up swapped between them -- but every window still lands on
    # one of the slot's actual target workspaces (never "wherever the
    # user currently is", which was the original bug) and none are ever
    # left unplaced.
    deadline = time.monotonic() + 8.0
    while pending and time.monotonic() < deadline:
        for address in sorted(client_addresses() - seen):
            if not pending:
                break
            move(address, targets[pending.pop(0)])
            seen.add(address)
        if pending:
            time.sleep(0.15)


def cmd_fluid(args):
    n = args.n
    validate_slot(n)
    cfg = load_config()
    cfg["fluidSlot"] = n
    save_config(cfg)
    print(f"fluid slot set to {n}")


def cmd_capture_fluid(args):
    cfg = load_config()
    fluid_slot = cfg.get("fluidSlot")
    if not fluid_slot:
        return

    result = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        print("error: hyprctl clients -j failed", file=sys.stderr)
        sys.exit(1)
    clients = json.loads(result.stdout)

    commands = []
    seen_classes = set()
    for client in clients:
        cls = client.get("class", "")
        if not cls or cls in seen_classes:
            continue
        seen_classes.add(cls)
        workspace = client.get("workspace", {}).get("id")
        if workspace is None:
            continue
        commands.append({"command": cls.lower(), "workspace": workspace})

    existing = load_workstation(fluid_slot)
    name = existing.get("name", f"Workstation {fluid_slot}")

    save_workstation(fluid_slot, {
        "id": fluid_slot,
        "name": name,
        "mode": "fluid",
        "commands": commands,
    })
    print(f"captured {len(commands)} window(s) into fluid slot {fluid_slot}")


def xdg_applications_dirs():
    # $XDG_DATA_HOME/applications, then each $XDG_DATA_DIRS entry's
    # /applications -- the standard XDG locations, in precedence order
    # (earlier wins on a filename collision). This machine has nothing
    # beyond /usr/share and ~/.local/share (no flatpak/snap), but reading
    # XDG_DATA_DIRS rather than hardcoding picks those up automatically if
    # installed later.
    home_data = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    dirs = [Path(home_data) / "applications"]
    data_dirs = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    for d in data_dirs.split(":"):
        if d:
            dirs.append(Path(d) / "applications")
    return dirs


def strip_exec_field_codes(exec_value):
    stripped = FIELD_CODE_RE.sub("", exec_value)
    stripped = stripped.replace("%%", "%")
    return re.sub(r"\s+", " ", stripped).strip()


def parse_desktop_entry(path):
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    try:
        with open(path, encoding="utf-8") as f:
            parser.read_file(f)
    except (OSError, UnicodeDecodeError, configparser.Error):
        return None
    if not parser.has_section("Desktop Entry"):
        return None
    section = parser["Desktop Entry"]
    if section.get("Type", "Application") != "Application":
        return None
    if section.get("NoDisplay", "false").strip().lower() == "true":
        return None
    if section.get("Hidden", "false").strip().lower() == "true":
        return None
    name = section.get("Name", "").strip()
    exec_raw = section.get("Exec", "").strip()
    if not name or not exec_raw:
        return None
    command = strip_exec_field_codes(exec_raw)
    if not command:
        return None
    return {"name": name, "command": command}


def cmd_list_apps(args):
    seen_filenames = set()
    seen_entries = set()
    apps = []
    for app_dir in xdg_applications_dirs():
        if not app_dir.is_dir():
            continue
        for entry_path in sorted(app_dir.glob("*.desktop")):
            if entry_path.name in seen_filenames:
                continue
            seen_filenames.add(entry_path.name)
            parsed = parse_desktop_entry(entry_path)
            if not parsed:
                continue
            dedup_key = (parsed["name"], parsed["command"])
            if dedup_key in seen_entries:
                continue
            seen_entries.add(dedup_key)
            apps.append(parsed)
    apps.sort(key=lambda a: a["name"].lower())
    print(json.dumps(apps))


def cmd_boot_slot(args):
    n = args.n
    validate_slot(n)
    cfg = load_config()
    cfg["bootSlot"] = n
    save_config(cfg)
    print(f"boot slot set to {n}")


def cmd_boot(args):
    cfg = load_config()
    # bootSlot names the preset that should always launch at startup.
    # fluidSlot is the separate "restore last session" concept, used as a
    # fallback so `boot` still does something useful if no bootSlot is set.
    slot = cfg.get("bootSlot") or cfg.get("fluidSlot")
    if not slot:
        return
    cmd_launch(type("Args", (), {"n": slot})())


def build_parser():
    import argparse
    parser = argparse.ArgumentParser(prog="quattro-workstation", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("list", help="print all 5 slots with name and fluid status").set_defaults(func=cmd_list)

    p = sub.add_parser("launch", help="launch the given workstation slot")
    p.add_argument("n", type=int, help="slot number 1-5")
    p.set_defaults(func=cmd_launch)

    p = sub.add_parser("fluid", help="mark the given slot as the fluid slot")
    p.add_argument("n", type=int, help="slot number 1-5")
    p.set_defaults(func=cmd_fluid)

    sub.add_parser("capture-fluid", help="snapshot current windows into the fluid slot").set_defaults(func=cmd_capture_fluid)

    p = sub.add_parser("boot-slot", help="mark the given slot to always launch at startup")
    p.add_argument("n", type=int, help="slot number 1-5")
    p.set_defaults(func=cmd_boot_slot)

    sub.add_parser("boot", help="launch bootSlot, else fluidSlot, else no-op").set_defaults(func=cmd_boot)

    sub.add_parser("list-apps", help="list installed apps as JSON [{name, command}], for building commands").set_defaults(func=cmd_list_apps)

    # Internal: spawned by launch itself, not meant to be run by hand.
    p = sub.add_parser("_place-windows", help=argparse.SUPPRESS)
    p.add_argument("before")
    p.add_argument("targets")
    p.add_argument("pids")
    p.set_defaults(func=cmd_place_windows)

    return parser


def main():
    ensure_initialized()
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
